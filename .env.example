# Local server defaults. Run pnpm setup:env to generate .env with a random secret.
HOST=127.0.0.1
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_ON_SETUP

# New private instances use one-time owner setup. Keep public registration disabled.
MIRALO_ALLOW_SIGNUP=false

# Relative paths resolve from the repository root.
MIRALO_DATA_DIR=./data
MIRALO_TEMPLATE_DIR=./templates/miralo
