# Local server defaults. Run pnpm setup:env to generate .env with a random secret.
HOST=127.0.0.1
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_ON_SETUP

# Enable local account creation; set false after creating your account.
FREEFLOW_ALLOW_SIGNUP=true

# Relative paths resolve from the repository root.
FREEFLOW_DATA_DIR=./data
FREEFLOW_TEMPLATE_DIR=./templates/freeflow
