{
  "name": "miralo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "miralo": "tsx apps/cli/src/main.ts",
    "server": "pnpm run dev",
    "dev": "pnpm --filter @miralo/editor build && pnpm --filter @miralo/server dev",
    "setup:env": "node scripts/setup-env.mjs",
    "owner:token": "pnpm --filter @miralo/server exec tsx src/setup-token.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:docker": "node scripts/docker-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@miralo/compiler": "workspace:*",
    "@types/node": "^22.20.2",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "turbo": "^2.10.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
