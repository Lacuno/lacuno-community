# Copy to .env.docker. Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
LACUNO_PUBLISH_BASE_URL=http://localhost:3001
# Keep disabled. New instances use one-time, token-protected owner setup.
LACUNO_ALLOW_SIGNUP=false
# Published forms mail each message to the workspace owner through this server, for example
# smtps://user:password@smtp.example.com:465 and Lacuno <forms@example.com>. Empty: forms are off.
LACUNO_SMTP_URL=
LACUNO_MAIL_FROM=
