// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateStylesheet > matches the snapshot for the fixture 1`] = `
"*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; min-height: 100dvh; }
img, video, svg { display: block; max-width: 100%; height: auto; }
button, input, select, textarea { font: inherit; color: inherit; }
a { color: inherit; }

:root {
  --color-bg: #fff;
  --color-border: #dee2e6;
  --color-brand: #3b5bdb;
  --color-brand-hover: #2f4ac0;
  --color-fg: #111;
  --color-surface-muted: #f1f3f5;
  --font-body: Inter, system-ui, sans-serif;
  --radius-md: 8px;
  --space-lg: 2rem;
  --space-md: 1rem;
  --space-sm: 0.5rem;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --color-bg: #111;
    --color-border: #333;
    --color-brand-hover: #5c7cfa;
    --color-fg: #eee;
    --color-surface-muted: #222;
  }
}
[data-theme="dark"] {
  --color-bg: #111;
  --color-border: #333;
  --color-brand-hover: #5c7cfa;
  --color-fg: #eee;
  --color-surface-muted: #222;
}

.button {
  display: inline-flex;
  padding: var(--space-sm) var(--space-md);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background-color 150ms;
}
.button:hover {
  background-color: var(--color-surface-muted);
}
.button:focus-visible {
  outline: 2px solid var(--color-brand);
}
.card {
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.card::before {
  content: "";
}
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-md);
}
.heading {
  margin: 0;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 1.1;
}
.hero {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-lg);
  padding-block: clamp(3rem, 8vw, 8rem);
}
.page {
  font-family: var(--font-body);
  color: var(--color-fg);
  background-color: var(--color-bg);
}
.post-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-md);
}
.product {
  max-width: 60%;
  --lc-range: entry;
  --lc-scroll: lc-scale-up;
}
.stage {
  display: grid;
  place-items: center;
}
.step {
  --lc-scroll: lc-fade-through;
}
.button.primary {
  color: #fff;
  background-color: var(--color-brand);
}
.button.primary:hover {
  background-color: var(--color-brand-hover);
}
.lc-l-hero-title.lc-l-hero-title.lc-l-hero-title.lc-l-hero-title {
  letter-spacing: -0.02em;
}

@media (max-width: 991px) {
  .hero {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 479px) {
  .heading {
    text-align: center;
  }
}


* { --lc-duration: 400ms; --lc-delay: 0ms; --lc-easing: ease-out; --lc-entrance: none; --lc-scroll: none; --lc-range: entry; --lc-timeline: view(); --lc-parallax: 80px; }
@keyframes lc-fade { from { opacity: 0; } }
@keyframes lc-slide-up { from { opacity: 0; translate: 0 24px; } }
@keyframes lc-slide-down { from { opacity: 0; translate: 0 -24px; } }
@keyframes lc-slide-left { from { opacity: 0; translate: 24px 0; } }
@keyframes lc-slide-right { from { opacity: 0; translate: -24px 0; } }
@keyframes lc-scale-up { from { opacity: 0; scale: .85; } }
@keyframes lc-blur-in { from { opacity: 0; filter: blur(12px); } }
@keyframes lc-fade-out { to { opacity: 0; } }
@keyframes lc-parallax { from { translate: 0 var(--lc-parallax); } to { translate: 0 calc(-1 * var(--lc-parallax)); } }
@keyframes lc-fade-through { 0% { opacity: 0; translate: 0 24px; } 25%, 75% { opacity: 1; translate: 0; } 100% { opacity: 0; translate: 0 -24px; } }
@keyframes lc-progress { from { scale: 0 1; } }
@media (prefers-reduced-motion: no-preference) {
  :where([data-lacuno-motion]) {
    transition-property: opacity, scale, rotate, translate, transform, box-shadow, background-color, color, border-color, outline-color;
    transition-duration: var(--lc-duration, 400ms);
    transition-delay: var(--lc-delay, 0ms);
    transition-timing-function: var(--lc-easing, ease-out);
  }
  :where([data-lacuno-motion][data-lc-enter]) {
    animation: var(--lc-entrance, none) var(--lc-duration, 400ms) var(--lc-easing, ease-out) var(--lc-delay, 0ms) both;
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-lacuno-motion] { animation: none !important; transition: none !important; }
}


@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    :where(:root:not([data-lacuno-still]) [data-lc-story]) {
      view-timeline-name: --lc-story;
      min-height: calc(var(--lc-length, calc(var(--lc-steps, 2) + 1)) * 100svh);
    }
    :where(:root:not([data-lacuno-still]) [data-lc-story] > :first-child) { position: sticky; top: 0; height: 100svh; overflow: clip; }
    :where(:root:not([data-lacuno-still]) [data-lc-story] *) { --lc-timeline: --lc-story; --lc-range: contain; }
    :where(:root:not([data-lacuno-still]) [data-lc-step]) { grid-area: 2 / 1; }
    :where(:root:not([data-lacuno-still]) [data-lacuno-motion="scroll"]) {
      animation: var(--lc-scroll) linear both;
      animation-timeline: var(--lc-timeline);
      animation-range: var(--lc-range);
    }
  }
}

:where([data-lc-steps="3"]) { --lc-steps: 3; }
:where([data-lc-steps="3"] [data-lc-step="1"]) { --lc-range: contain 0% contain 33.3333%; }
:where([data-lc-steps="3"] [data-lc-step="2"]) { --lc-range: contain 33.3333% contain 66.6667%; }
:where([data-lc-steps="3"] [data-lc-step="3"]) { --lc-range: contain 66.6667% contain 100%; }
"
`;
