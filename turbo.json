{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["CHROME_PATH", "LACUNO_FAST_TESTS"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"] },
    "@lacuno/compiler#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/lacuno/lacuno.json",
        "$TURBO_ROOT$/templates/lacuno/assets/**"
      ]
    },
    "@lacuno/server#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/lacuno/lacuno.json",
        "$TURBO_ROOT$/templates/lacuno/assets/**"
      ]
    },
    "@lacuno/renderer#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/templates/lacuno/lacuno.json"]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
