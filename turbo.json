{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"] },
    "@freeflow/compiler#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/freeflow/freeflow.json",
        "$TURBO_ROOT$/templates/freeflow/assets/**"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
